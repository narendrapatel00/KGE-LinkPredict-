# =====================================================================
# .gitignore -- Knowledge Graph Embedding & Link Prediction Project
# =====================================================================

# --- Virtual environments ---
venv/
.venv/
env/
.env/
ENV/

# --- Environment variable files ---
.env
*.env

# --- Python cache ---
__pycache__/
*.py[cod]
*.class
*.pyo

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg

# --- Model checkpoints & large binary outputs ---
outputs/checkpoints/
models/*.pkl
models/*.pt
models/*.pth

# --- Dataset files (downloaded separately) ---
data/

# --- Results (generated at runtime) ---
outputs/results/

# --- Jupyter / IPython ---
.ipynb_checkpoints/
*.ipynb

# --- Testing artefacts ---
.pytest_cache/
.coverage
htmlcov/

# --- IDE / editor ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS files ---
.DS_Store
Thumbs.db

# --- Temporary files ---
*.tmp
*.bak
*.swp
*~
