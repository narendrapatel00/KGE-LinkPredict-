# =====================================================================
# .gitignore -- KGE-LinkPredict
# =====================================================================

# --- Virtual Environments ---
.venv/
venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Environment & Secret Files ---
.env
*.env
*.pem
*.key
credentials.json
secrets.json

# --- Python Cache & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# --- Distribution / Packaging ---
dist/
build/
*.egg-info/
*.egg

# --- Model Checkpoints & Large Binary Files ---
checkpoints/
outputs/checkpoints/
**/outputs/checkpoints/
models/*.pkl
models/*.pt
models/*.pth
*.pkl
*.pt
*.pth
*.bin
*.onnx
*.h5

# --- Dataset Files & Caches (FB15k-237 downloaded dynamically) ---
data/
**/data/
.pykeen/

# --- Output Results (Generated at runtime) ---
outputs/results/
**/outputs/results/

# --- Jupyter / IPython Notebooks ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Testing & Coverage Artifacts ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- IDE & Editor Settings ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS-generated Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Temporary & Log Files ---
*.tmp
*.bak
*.swp
*~
*.log
